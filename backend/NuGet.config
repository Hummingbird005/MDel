<?xml version="1.0" encoding="utf-8"?>
<!--
  Pachetele NuGet se iau DOAR din folderul offline/nuget al repository-ului (funcționează fără internet).
  Calea e relativă la acest fișier. Pentru o dependență nouă: offline/create-offline-bundle.sh (cu internet).
  „dotnet ef migrations bundle” compilează într-un folder temporar: rulați-l cu variabila de mediu
  RestoreConfigFile=<cale completă către acest fișier> (scripturile de publicare o setează singure).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="mdel-offline" value="../offline/nuget" />
  </packageSources>
</configuration>

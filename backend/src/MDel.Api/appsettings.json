{
  "ConnectionStrings": {
    "MDel": "Server=localhost;Database=MDel;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Authentication": {
    "Mode": "Negotiate",
    "Groups": {
      "Admins": "",
      "Approvers": ""
    }
  },
  "Integrations": {
    "UseFakes": false
  },
  "DataProtection": {
    "KeysPath": "C:\\ProgramData\\MDel\\keys"
  },
  "Scheduler": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "ReconcileMinutes": 60
  },
  "Uploads": {
    "MaxRequestBodyBytes": 115343360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

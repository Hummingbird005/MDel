      "Groups.AdminsEmail": "",
      "Groups.Approvers": "",
      "Groups.ApproversEmail": "",
      "General.BaseUrl": ""
    }
  },
  "Integrations": {
    "UseFakes": false
  },
  "DataProtection": {
    "KeysPath": "C:\\ProgramData\\MDel\\keys"
  },
  "Scheduler": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "ReconcileMinutes": 60
  },
  "Uploads": {

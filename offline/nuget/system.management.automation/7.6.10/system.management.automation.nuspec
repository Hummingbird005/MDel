<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>System.Management.Automation</id>
    <version>7.6.10</version>
    <authors>Microsoft</authors>
    <owners>Microsoft,PowerShell</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Powershell_black_64.png</icon>
    <projectUrl>https://github.com/PowerShell/PowerShell</projectUrl>
    <description>Runtime for hosting PowerShell</description>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <language>en-US</language>
    <tags>PowerShell</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.PowerShell.CoreCLR.Eventing" version="7.6.10" />
        <dependency id="Newtonsoft.Json" version="13.0.4" />
        <dependency id="Microsoft.ApplicationInsights" version="2.23.0" />
        <dependency id="Microsoft.Win32.Registry.AccessControl" version="10.0.15" />
        <dependency id="System.CodeDom" version="10.0.15" />
        <dependency id="System.Configuration.ConfigurationManager" version="10.0.15" />
        <dependency id="System.Diagnostics.EventLog" version="10.0.15" />
        <dependency id="System.DirectoryServices" version="10.0.15" />
        <dependency id="System.Management" version="10.0.15" />
        <dependency id="System.Security.Cryptography.Pkcs" version="10.0.15" />
        <dependency id="System.Security.Cryptography.ProtectedData" version="10.0.15" />
        <dependency id="System.Security.Permissions" version="10.0.15" />
        <dependency id="Microsoft.Management.Infrastructure" version="3.0.0" />
        <dependency id="Microsoft.PowerShell.Native" version="700.0.2" />
        <dependency id="Microsoft.Security.Extensions" version="1.4.0" />
        <dependency id="System.Windows.Extensions" version="10.0.15" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="**/*" buildAction="None" copyToOutput="true" flatten="false" />
    </contentFiles>
  </metadata>
</package>